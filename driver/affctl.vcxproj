<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-0001-4A11-9E22-AFF0DA771001}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <RootNamespace>affctl</RootNamespace>
    <TargetName>affctl</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <SpectreMitigation>false</SpectreMitigation>
    <!-- Desabilita test-signing automatico do WDK (Inf2Cat + SignTool).
         O sys sai nao-assinado; funciona em maquina com "bcdedit /set
         testsigning on". Para producao a assinatura sera feita externamente
         com o EV cert via signtool.exe manual (ou via pipeline de release). -->
    <SignMode>Off</SignMode>
    <EnableInf2cat>False</EnableInf2cat>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- Ancora output em $(ProjectDir) (a propria pasta do vcxproj) em vez de
       $(SolutionDir), que varia com a .sln aberta. Precisa vir DEPOIS dos
       Cpp.*.props para nao ser sobrescrito pelos defaults do WDK. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="driver.cpp" />
    <ClCompile Include="tagwnd.cpp" />
    <ClCompile Include="inject.cpp" />
    <ClCompile Include="process_notify.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="tagwnd.h" />
    <ClInclude Include="win32k_structs.h" />
    <ClInclude Include="inject.h" />
    <ClInclude Include="process_notify.h" />
    <ClInclude Include="..\shared\affctl_shared.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="affctl.inf" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <!-- /INTEGRITYCHECK: exigido por PsSetCreateProcessNotifyRoutineEx.
           Sem isso a API retorna STATUS_ACCESS_DENIED em tempo de execucao. -->
      <AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
      <!-- wdmsec.lib: IoCreateDeviceSecure + SDDL constants (SDDL_DEVOBJ_*). -->
      <AdditionalDependencies>wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- Debug-only: expoe IOCTL_READ_RANGE e IOCTL_AFF_DIAG (usados p/ descobrir
       offset da flag DisplayAffinity durante desenvolvimento). Em Release
       esses IOCTLs sao compilados fora — dispatch retorna
       STATUS_INVALID_DEVICE_REQUEST se algum caller tentar chamar. -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PreprocessorDefinitions>AFFCTL_DIAG_IOCTLS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
